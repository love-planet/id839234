
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#111111">
  <title>Continue to Telegram</title>

  <style>
    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      margin: 0;
      width: 100%;
      min-height: 100%;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      color: #fff;
      background:
        linear-gradient(rgba(0,0,0,.35), rgba(0,0,0,.55)),
        url("https://i.postimg.cc/76CC585T/photo-2026-10-14-23-17-26.jpg?v=2")
        center center / cover no-repeat fixed;
    }

    .container {
      width: 100%;
      max-width: 380px;
      text-align: center;
    }

    .telegram-button {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 56px;
      padding: 16px 20px;
      border: none;
      border-radius: 12px;
      background: #229ed9;
      color: #fff;
      font-size: 17px;
      font-weight: 700;
      line-height: 1.3;
      text-decoration: none;
      cursor: pointer;
      user-select: none;
      -webkit-user-select: none;
      -webkit-touch-callout: default;
    }

    .telegram-button.disabled {
      opacity: .55;
      cursor: not-allowed;
    }

    .hint {
      margin-top: 18px;
      font-size: 14px;
      line-height: 1.5;
      color: #fff;
      text-shadow: 0 1px 4px rgba(0,0,0,.8);
    }
  </style>
</head>

<body>
  <main class="container">
    <a id="telegramLink" class="telegram-button" role="button">
      Продолжить в Telegram
    </a>
    <div id="hint" class="hint"></div>
  </main>

  <script>
    (() => {
      const telegram = "https://t.me/pys365";
      const ua = navigator.userAgent || "";

      const link = document.getElementById("telegramLink");
      const hint = document.getElementById("hint");

      // Ссылка изначально отсутствует — кнопка не может
      // открыть Telegram, пока устройство не проверено.
      link.removeAttribute("href");
      link.classList.add("disabled");
      link.setAttribute("aria-disabled", "true");

      const isIOS =
        /iPhone|iPad|iPod/i.test(ua) ||
        (
          navigator.platform === "MacIntel" &&
          navigator.maxTouchPoints > 1
        );

      const isAndroid = /Android/i.test(ua);
      const isMobile = isIOS || isAndroid;

      const isInApp =
        /TikTok|musical_ly|Bytedance|Instagram|FBAN|FBAV|FB_IAB|Line\/|Twitter|Snapchat|;\s?wv\)/i.test(ua);

      const en = (navigator.language || "ru")
        .toLowerCase()
        .startsWith("en");

      // Все остальные ОС: остаёмся на лендинге,
      // кнопка неактивна, ссылка отсутствует.
      if (!isMobile) {
        hint.textContent = "";
        return;
      }

      // iOS и Android во внешнем браузере.
      if (!isInApp) {
        window.location.replace(telegram);
        return;
      }

      // iOS во встроенном браузере.
      if (isIOS) {
        hint.textContent = en
          ? 'If Telegram doesn’t open, press and hold the link for 2 seconds, then tap “…” and choose “Open in Browser.”'
          : 'Если Telegram не открылся, нажми и удерживай ссылку 2 секунды, затем нажми «…» и выбери «Открыть в браузере».';

        link.href = telegram;
        link.classList.remove("disabled");
        link.removeAttribute("aria-disabled");

        // Обычное нажатие не открывает ссылку.
        link.addEventListener("click", event => {
          event.preventDefault();
        });

      } else {
        // Android во встроенном браузере.
        hint.textContent = en
          ? 'Tap ⋯ at the top and select "Open in Browser".'
          : 'Нажми ⋯ вверху и выбери «Открыть в браузере».';

        // Ссылка отсутствует, кнопка отключена.
        link.removeAttribute("href");
        link.classList.add("disabled");
        link.setAttribute("aria-disabled", "true");
      }
    })();
  </script>
</body>
</html>
